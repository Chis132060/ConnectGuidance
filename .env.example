DJANGO_SECRET_KEY=your-secret-key
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Supabase PostgreSQL — Dashboard → Settings → Database → Connection string (URI)
# Use sslmode=require. Prefer the pooled port (6543) for serverless, or 5432 direct.
DB_NAME=postgres
DB_USER=postgres
DB_PASSWORD=your-password
DB_HOST=your-supabase-host
DB_PORT=5432
DB_SSLMODE=require

DATABASE_URL=postgres://your-supabase-host:5432/postgres?sslmode=require

# Phase 5 — case note encryption (64 hex characters = 32 bytes)
ENCRYPTION_KEY=

# Phase 6 — AI chat (set at least one)
GROQ_API_KEY=
ANTHROPIC_API_KEY=
GROQ_MODEL=
CHAT_RATE_LIMIT_MAX=24
CHAT_SESSION_GET_MAX=60
